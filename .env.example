# Настройки боевого сервера. Скопируйте в .env (он в .gitignore) и заполните.
# Файл читает systemd (EnvironmentFile=) или вы вручную перед запуском.

# production включает строгие проверки: без своего пароля родителя сервер не запустится
ENGLISH_ENV=production

# Пароль кабинета родителя: не короче 8 символов, не «простой»
ENGLISH_PARENT_PASSWORD=придумайте-длинный-пароль

# Ключ подписи сессий. Если не задан, создаётся файл .secret_key рядом с проектом.
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
# ENGLISH_SECRET_KEY=

# Перед приложением стоит свой прокси (Caddy/nginx): доверять его заголовкам X-Forwarded-*
ENGLISH_BEHIND_PROXY=1

# Путь к базе (по умолчанию english_app.db рядом с app.py)
# ENGLISH_APP_DB=/var/lib/english/english_app.db

# Куда и сколько хранить резервных копий
# ENGLISH_BACKUP_DIR=/var/backups/english
# ENGLISH_BACKUP_KEEP=14

# Cookie только по HTTPS (в production включено само; 0 — для проверки по http без домена)
# ENGLISH_COOKIE_SECURE=1

# Сколько дней ребёнку не нужно вводить пароль / сколько часов действует вход родителя
# Тренировка произношения (микрофон). 0 — выключить. Chrome/Edge отправляют звук
# на распознавание в сервис браузера (Google/Microsoft).
# ENGLISH_SPEAKING=1
# ENGLISH_SESSION_DAYS=30
# ENGLISH_PARENT_SESSION_HOURS=12

# Адрес и порт для serve.py (Windows/дом). Для gunicorn: ENGLISH_BIND=127.0.0.1:8000
# ENGLISH_HOST=127.0.0.1
# PORT=8000
